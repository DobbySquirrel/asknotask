# Copy to .env if you like; the code reads process environment variables.

# Local OpenAI-compatible server (default)
# LLM_URL=http://127.0.0.1:8000/v1
# LLM_MAX_TOKENS=4096
# LLM_SEED_VALUE=20261021

# Remote preset (optional): copy configs/llm.yaml.example to configs/llm.yaml
# LLM_PRESET=local
# LLM_CONFIG=/path/to/llm.yaml

# Or: LLM_PRESET=env
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# OPENAI_MODEL=

# vLLM launcher (scripts/start_vllm/start_vllm_qwencoder30b.sh)
# MODEL_PATH=/path/to/Qwen3-Coder-30B-A3B-Instruct
# CONDA_BASE=/path/to/miniconda3
# CONDA_ENV=Qwen3-32B

# SQLite databases: directory that will be linked as dataset/databases
# ASK_DATABASES=/path/to/sqlite/roots

# Scorer
# SCORER_WORK=outputs/scorer
# SCORER_BUILD=outputs/scorer/build
# SCORER_MODEL=/path/to/Qwen3-8B
# SCORER_THETA=0.5
# 检测提问前启用 Auto/Ask。默认关闭，以免加载 8B 模型或占用正在跑实验的 GPU。
# SCORER_ENABLE=1
# SCORER_DEVICE=cuda:1
# CLAM_JSON=dataset/clambsql/clambsql.json
