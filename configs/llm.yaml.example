# Copy to configs/llm.yaml and fill in your own keys if you use LLM_PRESET.
# Do not commit configs/llm.yaml. Local vLLM does not need this file.
llm_presets:
  local:
    base_url: http://127.0.0.1:8000/v1
    api_key: EMPTY
    model: Qwen3-Coder-30B-A3B-Instruct
    enable_thinking: false
  env:
    # handled in code via LLM_PRESET=env (OPENAI_API_KEY + OPENAI_BASE_URL)
    base_url: http://127.0.0.1:8000/v1
    api_key: EMPTY
    model: gpt-4o
